msgid "plugins.generic.colophon.displayName"
msgstr "Colophon"

msgid "plugins.generic.colophon.description"
msgstr "Generate a deposit-ready JATS/PMC package for a submission with Colophon, and attach it as a galley. An agent drives the run; a person decides."

msgid "plugins.generic.colophon.action.generate"
msgstr "Generate JATS with Colophon"

msgid "plugins.generic.colophon.action.resend"
msgstr "Update metadata"

msgid "plugins.generic.colophon.action.checkStatus"
msgstr "Check status"

msgid "plugins.generic.colophon.started"
msgstr "Colophon is producing the package. You will see the galley here when it finishes; use Check status if your server cannot receive webhooks."

msgid "plugins.generic.colophon.error.noSubmission"
msgstr "No submission in context."

msgid "plugins.generic.colophon.error.notConfigured"
msgstr "Colophon is not configured for this journal. Enter the API key in the plugin settings."

msgid "plugins.generic.colophon.error.noArticleCode"
msgstr "This submission is not linked to a Colophon article yet. Create the article on Colophon first, then store its code on the submission."

msgid "plugins.generic.colophon.error.api"
msgstr "Colophon refused the request: {$message}"

msgid "plugins.generic.colophon.settings.apiBase"
msgstr "API base URL (leave default for production)"

msgid "plugins.generic.colophon.settings.apiBaseInvalid"
msgstr "The API base must be a valid URL."

msgid "plugins.generic.colophon.settings.apiKey"
msgstr "API key (from Colophon's API keys page; shown once there)"

msgid "plugins.generic.colophon.settings.webhookSecret"
msgstr "Webhook signing secret (shown beside the API key at creation)"

msgid "plugins.generic.colophon.settings.secretStored"
msgstr "A value is stored. Leave blank to keep it; enter a new one to replace it."

msgid "plugins.generic.colophon.action.send"
msgstr "Send to Colophon"

msgid "plugins.generic.colophon.sent"
msgstr "Sent to Colophon — editing, references and typesetting run there. Files return here when the package is ready."

msgid "plugins.generic.colophon.error.noManuscript"
msgstr "No manuscript file found on this submission (looked for the final draft, then the original upload)."

msgid "plugins.generic.colophon.settings.connect"
msgstr "Connect to Colophon"

msgid "plugins.generic.colophon.settings.notConnected"
msgstr "Not connected. Press Connect: a Colophon tab opens to confirm, and the key arrives here by itself — nothing to copy."

msgid "plugins.generic.colophon.settings.connectedAs"
msgstr "Connected as {$name}"

msgid "plugins.generic.colophon.error.noApiBase"
msgstr "Enter your Colophon server address in the plugin settings, then press Connect."

msgid "plugins.generic.colophon.settings.openPanel"
msgstr "Open Colophon panel"

msgid "plugins.generic.colophon.settings.creditsRemaining"
msgstr "Credits remaining: {$n}"

msgid "plugins.generic.colophon.settings.topUp"
msgstr "Top up"

msgid "plugins.generic.colophon.settings.manageLink"
msgstr "Manage submissions"

msgid "plugins.generic.colophon.manage.title"
msgstr "Colophon submissions"

msgid "plugins.generic.colophon.manage.empty"
msgstr "No submissions have reached Copyediting yet. This list only shows submissions ready to be sent to Colophon."

msgid "plugins.generic.colophon.manage.stage"
msgstr "Stage"

msgid "plugins.generic.colophon.manage.status"
msgstr "Colophon status"

msgid "plugins.generic.colophon.menu"
msgstr "Colophon"

msgid "plugins.generic.colophon.action.downloadPackage"
msgstr "Download package (ZIP)"

msgid "plugins.generic.colophon.action.downloadPdf"
msgstr "Download PDF"

msgid "plugins.generic.colophon.action.attachGalley"
msgstr "Attach as galley"

msgid "plugins.generic.colophon.attached"
msgstr "Galley attached"

msgid "plugins.generic.colophon.error.noPackage"
msgstr "No finished package for this submission yet. Generate it first, then check status."

msgid "plugins.generic.colophon.error.noPdf"
msgstr "This package holds no PDF: typesetting was not requested for its issue."

msgid "plugins.generic.colophon.settings.delivery"
msgstr "Delivery"

msgid "plugins.generic.colophon.settings.deliveryDescription"
msgstr "How a finished package reaches you. Download writes nothing into OJS: the ZIP and the PDF are offered on the Colophon submissions page, and attaching a galley is a separate button. Galley attaches every finished package automatically."

msgid "plugins.generic.colophon.settings.delivery.download"
msgstr "Download from the Colophon page (default)"

msgid "plugins.generic.colophon.settings.delivery.galley"
msgstr "Attach as a JATS galley automatically"

msgid "plugins.generic.colophon.needsReview"
msgstr "Needs your review"

msgid "plugins.generic.colophon.action.review"
msgstr "Review on Colophon"
